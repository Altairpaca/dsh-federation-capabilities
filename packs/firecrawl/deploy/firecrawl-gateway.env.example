# Fedcap Firecrawl token gateway settings.
# Installed as ~/.config/fedcap/firecrawl-gateway.env by deploy/setup.sh.
# Keep the token file out of version control and mode 0600.
#
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=3003
# GATEWAY_UPSTREAM=http://127.0.0.1:3002
# GATEWAY_TOKEN_FILE=/opt/fedcap/firecrawl-gateway.token
# MAX_BODY_BYTES=8388608
# UPSTREAM_TIMEOUT_SECONDS=120

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3003
GATEWAY_UPSTREAM=http://127.0.0.1:3002
GATEWAY_TOKEN_FILE=/opt/fedcap/firecrawl-gateway.token
